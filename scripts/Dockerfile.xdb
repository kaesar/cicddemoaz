# Imagen XDB para Azure. Contexto: raíz del workspace (contiene xdb/ y scripts/).
# El Dockerfile de xdb no sirve en CI (COPY con ruta Windows), así que se compila
# aquí con el wrapper versionado del repo (Gradle 9.6.1, JDK 21).
# Config: scripts/onmind.ini bakeado en /app + ONMIND_INI (xdb resuelve sus
# os.environ/ en arranque con fail-fast; sin generadores).
# Build (pipeline): docker build -f scripts/Dockerfile.xdb -t <acr>/xdb:<tag> .
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY xdb/ ./
RUN chmod +x ./gradlew && ./gradlew shadowJar --no-daemon -x test

FROM eclipse-temurin:21-jre-alpine
WORKDIR /opt/onmind/run
COPY --from=build /src/build/libs/*-full.jar ./onmind-xdb.jar
COPY scripts/onmind.ini /app/onmind.ini
ENV ONMIND_INI=/app/onmind.ini
EXPOSE 9990
CMD ["java", "-jar", "/opt/onmind/run/onmind-xdb.jar", "onmindxdb"]
