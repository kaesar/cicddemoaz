# XDB solo lee este fichero como Properties (Rote: ./onmind.ini, ../onmind.ini o /app/onmind.ini).
# NO lee variables de entorno. Copiar a config/onmind.ini (gitignored) u onmind.ini según arranque.
# Base que Rote exige (sin app.local el arranque muere con NullPointerException).
app.mode = production
app.local = ./
app.base = /app
app.language = en
app.logger = -
app.modality = 5
app.deploy = 0
app.ui = +
dai.port = 9990
dai.cors = *
db.query_limit = 1200
# Puertos/servidor
dai.port = 9990
dai.host = http://localhost
dai.cors = *

# Auth: ENTRAID acepta `Authorization: Bearer <token de XID>`.
# REALIDAD (JwtValidator): solo verifica HS256 con secreto compartido; los access token de la
# fachada Entra de XID son RS256. Sin auth.jwt.secret se acepta el payload decodificado
# SIN verificar firma (solo dev). No pongas secret con tokens RS256 (daría 401).
auth.enabled = true
auth.type = ENTRAID
auth.oidc.url = http://localhost:8787
auth.oidc.client_id = my-webapp
# auth.jwt.secret = <solo si los tokens son HS256>
# auth.jwt.issuer = http://localhost:8787/common/v2.0

# Persistencia local; para Cosmos DB (Fase 3): kv.store = cosmosdb + kv.cosmosdb.*
kv.store = mvstore
kv.mvstore.name = xybox
# kv.store = cosmosdb
# kv.cosmosdb.endpoint = https://<cuenta>.documents.azure.com:443/
# kv.cosmosdb.key = <key de Key Vault>
# kv.cosmosdb.database = onmind
# kv.cosmosdb.container = kvstore
