PORT=8787
# dev = redirect_uri abierto + OTP por consola si no hay SMTP; production exige allowlist + mail real
XID_ENV=dev
# Tenant por defecto cuando la URL usa /common, /organizations o /consumers
XID_TENANT_ID=xid
# Redirects permitidos (obligatorio en production; en dev con lista vacía se admite todo http/https)
# XID_REDIRECT_ALLOWLIST=http://localhost:3000/*,https://<swa-host>/*
XID_CORS_ORIGINS=http://localhost:3000
# Allowlist de emails (por defecto ./xusers.txt del repo xid).
# Formato: `email` (solo OTP) o `email:$2b$...` (password bcrypt + OTP de respaldo).
# Gestionar con la CLI de xid: bun run cli user add|password|list <email>
XID_USERS_TXT=xusers.txt
# Clientes M2M con secreto (el flujo público authorize solo exige client_id no vacío y
# que coincida entre authorize y token; no requiere registro previo)
# XID_CLIENTS_TXT=xclients.txt
# RSA de la fachada Entra (si se omite, xid genera claves efímeras en cada arranque: los
# tokens dejan de validar tras reiniciar). Producción: JWK privada JSON con kid y alg RS256.
# XID_RSA_PRIVATE_JWK=<json>
# Secreto HMAC (solo flujos HS256/sesión; NO valida los RS256 de la fachada Entra)
# XID_JWT_SECRET=<secreto>
# SMTP dev (Mailpit en 127.0.0.1:1025; sin SMTP el OTP sale por consola en dev)
# XID_SMTP_HOST=127.0.0.1
# XID_SMTP_PORT=1025
# XID_SMTP_DISABLED=1
# En Azure: XID_TENANT_ID=<tid>, XID_CORS_ORIGINS=https://<swa-host>, XID_ENV=production
# NOTA: xid no sirve HTTPS y deriva `iss` y el discovery del Host de la petición.
# No existe XID_ISSUER: tras un proxy TLS hay que preservar el header Host.
